{
  "name": "ccaf-learner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run content:import",
    "dev": "next dev",
    "prebuild": "npm run content:import",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:import": "tsx scripts/import-content.ts",
    "content:quality": "tsx scripts/check-question-quality.ts",
    "content:validate:aicert": "CONTENT_DIR=content-aicert tsx scripts/validate-content.ts",
    "content:quality:aicert": "CONTENT_DIR=content-aicert tsx scripts/check-question-quality.ts",
    "content:report:aicert": "CONTENT_DIR=content-aicert tsx scripts/question-report.ts",
    "content:import:aicert": "CONTENT_DIR=content-aicert DATABASE_PATH=data/aicert.db tsx scripts/import-content.ts",
    "dev:aicert": "npm run content:import:aicert && CONTENT_DIR=content-aicert DATABASE_PATH=data/aicert.db next dev -p 3001",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "build:lessons": "tsx scripts/build-lessons-site.tsx"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9"
  }
}
